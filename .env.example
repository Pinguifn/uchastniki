# Режим Cloudflare Relay — рекомендуется, если Telegram API недоступен с VPS.
TELEGRAM_RELAY_URL=https://your-worker.workers.dev/notify
TELEGRAM_RELAY_SECRET=replace_with_64_character_random_secret

# Прямой режим — используется только если RELAY_URL и RELAY_SECRET не заполнены.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
